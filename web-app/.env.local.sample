# 이 파일을 복사해서 .env.local 로 저장하고 값을 채우세요.
# .env.local 은 .gitignore 처리됨.

# Supabase — anon key 는 공개돼도 안전한 키 (RLS 가 권한 결정)
NEXT_PUBLIC_SUPABASE_URL=https://dvdnlivivvrlxodnyusi.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...너의실제anon키

# QR 코드에 들어갈 URL prefix
# 개발 중 (노트북에서만): http://localhost:3000
# 폰 검증 시: http://192.168.x.y:3000 (노트북 LAN IP, `ifconfig | grep "inet "` 로 확인)
# Vercel 배포 후: https://your-project.vercel.app (또는 본인 도메인)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# 폰 검증 시 노트북 LAN IP. 비워두면 Next 16 dev 가 외부 origin 차단.
# BASE_URL 의 호스트만 (포트/스킴 제외)
NEXT_DEV_LAN_ORIGIN=
